<view class="list-container">
    <view class="list-container">
        <view class="list-box">
            <view class="search">
                <view class="search-inp-box">
                    <text class="iconfont icon-sousuo1"></text>
                    <input class="search-input" model:value="{{name}}" type="text" id=""   placeholder="名称" />
                </view>
                <view class="searchBtn"  bind:tap="search">搜索</view>
            </view>
            <view style="display: flex;">
                <view class="goodsList-box {{className}}">
                    <view class="goods-item" wx:for="{{goodsListData}}" wx:key="id" bind:tap="detailBtn" data-item="{{item}}">
                        <view class="goods-title">
                            {{item.name}}
                        </view>
                        <image class="goods-img" src="{{item.picture}}" mode="aspectFill" />
                        <view class="operate-shangpin">
                            <view style=" display: flex;width:inherit;justify-content: space-between;">
                            </view>
                        </view>
                        <view class="operate-box">
                            <view class="delete-box" catchtap="deletetap">
                                <text class="iconfont icon-shanchu1 del-icons"></text>
                                <text data-id="{{item.id}}" capture-bind:tap="deleteBtn" class="del-text">删除</text>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </view>
</view>