<wxs module="tool" src="../../utils/tool.wxs"></wxs>
<view class="update-container">
    <view class="content">
        <view class="form-box">
            <view class="item-box">
                <view class="item-label">用户账号</view>
                <input class="item-input"
                       type="text"
                       disabled="{{disabledForm.yonghuzhanghao==true}}"
                       placeholder="用户账号"
                       value="{{ruleForm.yonghuzhanghao}}"
                       bindinput="valueChange"
                       data-key="ruleForm.yonghuzhanghao"/>
            </view>
            <view class="item-box">
                <view class="item-label">用户密码</view>
                <input class="item-input"
                       type="text"
                       disabled="{{disabledForm.yonghumima==true}}"
                       placeholder="用户密码"
                       value="{{ruleForm.yonghumima}}"
                       bindinput="valueChange"
                       data-key="ruleForm.yonghumima"/>
            </view>
            <view class="item-box">
                <view class="item-label">用户姓名</view>
                <input class="item-input"
                       type="text"
                       disabled="{{disabledForm.yonghuxingming==true}}"
                       placeholder="用户姓名"
                       value="{{ruleForm.yonghuxingming}}"
                       bindinput="valueChange"
                       data-key="ruleForm.yonghuxingming"/>
            </view>
            <view class="item-box" bindtap="uploadtouxiang">
                <view class="item-label">头像</view>
                <image wx:if="{{ruleForm.touxiang}}"
                       class="item-img"
                       src="{{baseUrl+tool.split(ruleForm.touxiang,',')[0]}}"
                       mode="aspectFill"
                >
                </image>
                <image wx:else
                       class="item-img"
                       src="../../static/upload.png"
                       mode="aspectFill"
                       >
                </image>
            </view>
            <view class="item-box">
                <view class="item-label">性别</view>
                <picker class="down-item-picker"
                        model:value="{{xingbieIndex}}"
                        bindchange="xingbieChange"
                        range="{{xingbieOptions}}">
                    <view class="down-item-picker-text">
                        {{ruleForm.xingbie||"请选择性别"}}
                    </view>
                </picker>
            </view>
            <view class="item-box">
                <view class="item-label">手机号码</view>
                <input class="item-input"
                       type="text"
                       disabled="{{disabledForm.shoujihaoma==true}}"
                       placeholder="手机号码"
                       value="{{ruleForm.shoujihaoma}}"
                       bindinput="valueChange"
                       data-key="ruleForm.shoujihaoma"/>
            </view>
            <view class="item-box">
                <view class="item-label">余额</view>
                <input class="item-input"
                       type="digit"
                       disabled="{{disabledForm.money==true}}"
                       placeholder="余额"
                       value="{{ruleForm.money}}"
                       bindinput="valueChange"
                       data-key="ruleForm.money"/>
            </view>
        </view>
        <view class="btn-box">
            <button  class="submit-btn"
                     bindtap="onSubmitTap">提交
            </button>
        </view>
    </view>

</view>