<wxs module="tool" src="../../utils/tool.wxs"></wxs>
<view class="register-container">
    <view class="content">
        <view class="userInfo-from">
                <view class="item-box">
                    <view class="item-label">用户账号</view>
                    <input class="item-input"
                           type="text"
                           disabled="{{disabledForm.yonghuzhanghao}}"
                           placeholder="用户账号"
                           value="{{userInfo.yonghuzhanghao}}"
                           bindinput="valueChange"
                           data-key="userInfo.yonghuzhanghao"/>
                </view>
                <view class="item-box">
                    <view class="item-label">用户姓名</view>
                    <input class="item-input"
                           type="text"
                           disabled="{{disabledForm.yonghuxingming}}"
                           placeholder="用户姓名"
                           value="{{userInfo.yonghuxingming}}"
                           bindinput="valueChange"
                           data-key="userInfo.yonghuxingming"/>
                </view>
                <view class="item-box" bindtap="uploadtouxiang">
                    <view class="item-label">头像</view>
                    <image wx:if="{{userInfo.touxiang}}"
                           class="item-img"
                           src="{{baseUrl+tool.split(userInfo.touxiang,',')[0]}}"
                           mode="aspectFill"
                    >
                    </image>
                    <image wx:else
                           class="item-img"
                           src="../../static/upload.png"
                           mode="aspectFill"
                    >
                    </image>
                </view>
                <view class="item-box">
                    <text class="item-label">性别</text>
                    <picker class="down-item-picker" mode="selector"
                            disabled="{{disabledForm.xingbie}}"
                            range="{{xingbieOptions}}"
                            model:value="{{xingbieIndex}}"
                            bindchange="xingbieChange">
                        <view class="down-item-picker-text">
                            {{userInfo.xingbie||"请选择性别"}}
                        </view>
                    </picker>
                </view>
                <view class="item-box">
                    <view class="item-label">手机号码</view>
                    <input class="item-input"
                           type="text"
                           disabled="{{disabledForm.shoujihaoma}}"
                           placeholder="手机号码"
                           value="{{userInfo.shoujihaoma}}"
                           bindinput="valueChange"
                           data-key="userInfo.shoujihaoma"/>
                </view>
                <view class="item-box">
                    <view class="item-label">余额</view>
                    <input class="item-input"
                           type="text"
                           disabled="{{disabledForm.money}}"
                           placeholder="余额"
                           value="{{userInfo.money}}"
                           bindinput="valueChange"
                           data-key="userInfo.money"/>
                </view>
            <view class="btn-box">
                <button class="save-btn" bindtap="saveTap">保存</button>
                <button class="quite-btn" bindtap="quitTap">退出登录</button>
            </view>
            <view class="btn-box">
            </view>
        </view>
    </view>
</view>