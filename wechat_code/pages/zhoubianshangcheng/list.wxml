<wxs module="tool" src="../../utils/tool.wxs"></wxs>
<view class="list-container">
    <view class="list-box">
        <view class="search">

            <view class="search-inp-box">
                <text class="iconfont icon-sousuo1"></text>
                <input class="search-input" model:value="{{shangpinmingcheng}}" type="text" id=""
                       placeholder="商品名称"/>
            </view>
            <view class="searchBtn" bind:tap="search">搜索</view>

        </view>
        <div style="display: flex;" class="sort_box">
            <view bind:tap="sortClick" data-info="price" class="price_box">
                <image wx:if="{{sortType!='price' }}" src="../../static/sortImg/sortDefault.png"
                       mode="aspectFill" class="price_icon" style="width: 16px;height: 16px;"></image>
                <image wx:if="{{sortType=='price'&& sortOrder=='desc'}}" src="../../static/sortImg/desc.png"
                       mode="aspectFill" style="width: 16px;height: 16px;"></image>
                <image wx:if="{{sortType=='price'&&sortOrder=='asc' }}" src="../../static/sortImg/asc.png"
                       mode="aspectFill" style="width: 16px;height: 16px;"></image>
                <span class="price_text">  价格</span>
            </view>
            <view bind:tap="sortClick" data-info="storeupNumber" class="storeup_box">
                <image class="storeup_icon" wx:if="{{sortType!='storeupNumber'}}"
                       src="../../static/sortImg/sortDefault.png" mode="aspectFill"
                       style="width: 16px;height: 16px;"></image>
                <image wx:if="{{sortType=='storeupNumber' &&sortOrder=='desc'}}"
                       src="../../static/sortImg/desc.png" mode="aspectFill"
                       style="width: 16px;height: 16px;"></image>
                <image wx:if="{{sortType=='storeupNumber' &&sortOrder=='asc'}}"
                       src="../../static/sortImg/asc.png" mode="aspectFill"
                       style="width: 16px;height: 16px;"></image>
                <span class="storeup_text"> 收藏数</span>
            </view>
        </div>
        <button class="category-screen" bind:tap="toggle" data-key="popopShow">筛选</button>
        <button class="chart-btn" wx:if="{{(centerType&&hasBackChartsAuth)||(!centerType&&hasFrontChartsAuth)}}" bind:tap="showCharts">数据统计</button>
        <button class="add-btn" wx:if="{{centerType?auth.back['新增']:auth.front['新增']}}" bind:tap="addTap">新增</button>
        <view class="categoryFlag-box">
            <scroll-view scroll-x="true" scroll-y="true" class="silder">
                <view class="tab {{activeIndex == index ? 'active_tab' : ''}}"
                      wx:for="{{categoryList}}" wx:key="index" bindtap="categoryClick"
                      data-index="{{index}}" data-cate="{{item}}">
                    {{item}}
                </view>
            </scroll-view>

                <view class="goodsList-box">
                    <view class="goods-item" bind:tap="detailBtn" data-item="{{item}}" wx:for="{{goodsListData}}"
                          wx:key="index">
                        <image class="goods-img" data-item="{{item}}"
                               src="{{item.tupian}}" mode="aspectFill"/>
                        <view class="goods-title2-box">
                            <view class="goods-title" data-tableName="zhoubianshangcheng"
                                  data-item="{{item}}">
                                {{item.shangpinmingcheng}}
                            </view>

                            <view class="goods-title" data-tableName="zhoubianshangcheng"
                                  data-item="{{item}}">
                                商品分类:
                                {{item.shangpinfenlei}}
                            </view>

                            <view class="goods-title" data-tableName="zhoubianshangcheng"
                                  data-item="{{item}}">
                                发布时间:
                                {{item.addtime}}
                            </view>

                            <view class="list_price" data-id="{{item.id}}">
                                ￥{{item.price}}
                            </view>
                        </view>
    
                        <view class="operate-box">
                            <view capture-bind:tap="editBtn" data-item="{{item}}" class="edit-box" wx:if="{{centerType?auth.back['修改']:auth.front['修改']}}">
                                <text class="iconfont icon-xiugai1 edit-icons"></text>
                                <text class="edit-text">修改</text>
                            </view>
                            <view wx:if="{{centerType?auth.back['删除']:auth.front['删除']}}" class="delete-box" catchtap="deletetap">
                                <text class="iconfont icon-shanchu1 del-icons"></text>
                                <text capture-bind:tap="deleteBtn" data-id="{{item.id}}" data-item="{{item}}" class="del-text">删除</text>
                            </view>
                        </view>
                    </view>
    
                </view>
        </view>

    </view>
    <van-popup show="{{ popopShow }}" position="right" bind:close="toggle" data-key="popopShow">
        <view class="info-right" style="padding: 20px 0 80px;position: unset!important;">
            <view class="screen-input-box">
                <view class="screen-input-label">品牌</view>
                <input class="screen-intervalInput-item" placeholder="请输入品牌"
                       model:value="{{pinpai}}"/>
            </view>
            <view class="screen-btn-box">
                <button class="screen-btn-reset" bindtap="screenReset">重置</button>
                <button class="screen-btn-confirm" bindtap="search">确定</button>
            </view>
        </view>
    </van-popup>
</view>
