.charts-view{
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100vh;
}
.chartBtn-row{
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
}
.chartBtn-scroll{
    max-width: 100%;
    white-space: nowrap;
    width: auto;
    padding: 10rpx 0;
}
.chartBtn{
    margin: 0 10rpx;
}
.chartContainer{
    width: 100%;
    flex: 1;
    padding-bottom: 50px;
}
ec-canvas {
    width: 100%;
    height: 100%;
}
.condition-box{
    display: flex;
    justify-content: center;
    gap: 20rpx;
    flex-wrap: wrap;
    padding: 10rpx 20rpx;
}
.condition-picker{
    flex: 1;
    max-width: 49%;
    min-width: 40%;
    text-align: center;
    border: 1px solid #999;
    border-radius: 10rpx;
    padding: 8rpx;
}